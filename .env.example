# App
PORT=4000
NODE_ENV=development

# JWT (use strong secrets in production)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_chars_here
JWT_REFRESH_SECRET=your_super_secret_refresh_key_minimum_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Database Driver (postgres | mongodb | mysql)
DB_DRIVER=postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/ai_tutor_db
MONGO_URI=mongodb://localhost:27017/ai_tutor_db
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=password
MYSQL_DATABASE=ai_tutor_db

# Redis
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Queue Driver (rabbitmq | kafka)
QUEUE_DRIVER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@localhost:5672
KAFKA_BROKER=localhost:9092

# Rate Limiting
RATE_LIMIT_MAX=30
RATE_LIMIT_WINDOW_MS=60000

# Logging
LOG_LEVEL=info