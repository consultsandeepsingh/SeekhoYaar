{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": "./src",
    "paths": {
      "@auth/*": ["modules/auth/*"],
      "@user/*": ["modules/user/*"],
      "@student/*": ["modules/student-profile/*"],
      "@topic/*": ["modules/topic/*"],
      "@ai-tutor/*": ["modules/ai-tutor/*"],
      "@progress/*": ["modules/progress/*"],
      "@analytics/*": ["modules/analytics/*"],
      "@shared/*": ["shared/*"],
      "@config/*": ["config/*"],
      "@queue/*": ["queue/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}